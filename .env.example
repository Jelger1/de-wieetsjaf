# Voorbeeldconfiguratie. Kopieer naar .env (lokaal) of zet deze variabelen in je hosting (Cloudflare Pages:
# Settings > Variables and Secrets). Zet hier NOOIT echte waarden in: dit bestand staat in git.

# --- Website ---
# Publieke URL van de site (alleen bij een productiebouw nodig)
SITE_URL=https://www.wieetsjaf.nl
# 'productie' maakt de site indexeerbaar; laat leeg voor test- en previewomgevingen
SITE_ENV=

# --- Untappd for Business (alleen met een Premium-abonnement) ---
# E-mailadres van de PRIMAIRE gebruiker van het Untappd for Business-account
UNTAPPD_API_EMAIL=
# READ-ONLY API-token (Untappd for Business > Settings & Integrations > API Access). Geheim!
UNTAPPD_API_TOKEN=
# Location-ID (niet hetzelfde als het publieke venue-ID 685582). Vermoedelijk 22030, afgeleid uit
# de huidige embed-code; controleer in Untappd > Settings & Integrations > Location Settings.
UNTAPPD_LOCATION_ID=
# Menu-ID van de bierkaart (laatste cijfers in de URL als je het menu opent in het dashboard)
UNTAPPD_MENU_ID=
# Hoe lang (seconden) een opgehaalde kaart vers blijft. Standaard 900 (15 minuten), minimaal 60.
UNTAPPD_CACHE_SECONDEN=900
# Time-out per verzoek in milliseconden
UNTAPPD_TIMEOUT_MS=8000
# Een bier telt als 'nieuw' als het korter dan dit aantal dagen op de kaart staat
UNTAPPD_NIEUW_DAGEN=14
